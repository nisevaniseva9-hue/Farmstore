# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Django
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated list of https:// origins allowed to POST (needed once
# you're behind a real domain, e.g. https://www.yourfarmdomain.com)
CSRF_TRUSTED_ORIGINS=
# Only relevant when DEBUG=False. Leave as-is unless you have a specific
# reason to serve both HTTP and HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# PostgreSQL
DB_NAME=farmstore_dev
DB_USER=farmstore_user
DB_PASSWORD=devpassword123
DB_HOST=127.0.0.1
DB_PORT=5432

# Farm info
FARM_NAME=Farm Fresh
FARM_TAGLINE=Fresh products directly from our farm.

# WhatsApp Notifications Configuration (leave 'console' until API is purchased)
# Options: console | meta | twilio
WHATSAPP_PROVIDER=console

# If using Meta WhatsApp Cloud API:
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# If using Twilio WhatsApp API:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# UPI (Phase 7 - leave blank for now)
UPI_ID=
UPI_DISPLAY_NAME=
